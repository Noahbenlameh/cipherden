{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecureVault",
  "version": "0.1.0",
  "identifier": "dev.securevault.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SecureVault",
        "width": 1100,
        "height": 720,
        "minWidth": 700,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": []
  }
}
