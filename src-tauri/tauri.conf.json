{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CIPHERDEN",
  "version": "0.1.0",
  "identifier": "dev.cipherden.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CIPHERDEN",
        "width": 1100,
        "height": 720,
        "minWidth": 700,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; media-src 'self' blob:; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": []
  }
}
